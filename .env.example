# Пример конфигурации. Скопируйте в .env и впишите один из ключей:
#   Windows:     copy .env.example .env
#   macOS/Linux: cp .env.example .env
# Файл .env в git не попадает (см. .gitignore). Ключи не коммитить.

# Провайдер: deepseek | gemini | openai (любой OpenAI-совместимый API) | fake (офлайн-проверка без модели).
# Пусто — по ключу: задан DEEPSEEK_API_KEY → deepseek, иначе gemini.
LLM_PROVIDER=

# DeepSeek — основная модель решения (DeepSeek V4.1 Flash). Ключ: https://platform.deepseek.com/api_keys
# Нужен положительный баланс; дневной квоты нет.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Google AI Studio — бесплатный тариф. Ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ID модели из AI Studio: Flash-модель, доступная в бесплатном тарифе вашего проекта.
# Если модель недоступна, агент выведет список доступных.
GEMINI_MODEL=gemini-3.6-flash

# Резервные модели через запятую. Если основная перегружена (503), исчерпала квоту или недоступна
# для ключа, агент переключается на следующую и пишет об этом в отчёте.
# Модели другого поставщика пропускаются: список gemini-* не мешает работе с DeepSeek.
LLM_FALLBACK_MODELS=gemini-3.8-flash,gemini-2.5-flash,gemini-3.1-flash-lite

# Другой OpenAI-совместимый провайдер (LLM_PROVIDER=openai): OpenAI, OpenRouter, Groq, Ollama, vLLM
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=

# Параметры вызовов модели
LLM_TEMPERATURE=0
LLM_SEED=42
# Лимит запросов в минуту: для Gemini сверьте с лимитами вашего проекта в AI Studio
LLM_MAX_RPM=10
# Параллельных вызовов: с DeepSeek 4–8 (при 8 прогон выданного документа — около 10 минут);
# для бесплатного Gemini при частых ответах 429 поставьте 1
LLM_CONCURRENCY=4
# «Размышления» модели: default | off | minimal | low | medium | high
LLM_THINKING=default
# Лимит длины ответа и тайм-аут подбираются под провайдера (DeepSeek — 131 072 токена и 900 с)
# LLM_MAX_OUTPUT_TOKENS=131072
# LLM_TIMEOUT_S=900
# Требований в одном вызове проверки: по умолчанию 8, у Gemini — не больше 4 вызовов на документ
# REQCHECK_BATCH_SIZE=8
